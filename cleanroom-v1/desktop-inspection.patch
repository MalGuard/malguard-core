+def test_short_unquoted_credentials_are_redacted_from_preview():
+    content = b'password=abc\nauthorization=Basic YTo=\napi_key=xyz'
+    info = describe(identify(content, '.txt'), 'notes.txt', len(content), True)
+    assert 'abc' not in info['preview']
+    assert 'YTo=' not in info['preview']
+    assert 'xyz' not in info['preview']
+    assert info['preview'].count('[REDACTED]') == 3
+
