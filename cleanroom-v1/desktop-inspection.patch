+"""Offline, signed authorization of a private frozen build on one Windows device."""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import hmac
+import json
+import re
+import sys
+from pathlib import Path
+
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+
+from malguard_cli.license_policy import PRIVATE_APP_VERSION, PRIVATE_LICENSE_PUBLIC_KEY_HEX
+
+DOMAIN = b"MalGuard device license v1\x00"
+MAX_LICENSE_BYTES = 4096
+
+
+class LicenseError(ValueError):
+    """A bounded public failure code, never raw device or license contents."""
+
+
+def _unique_pairs(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise LicenseError("LICENSE_INVALID")
+        result[key] = value
+    return result
+
+
+def verify_license(data: bytes, public_key_hex: str, fingerprint: str) -> None:
+    """Reject wrong devices, modified licenses, ambiguous JSON and other versions."""
+    if not 0 < len(data) <= MAX_LICENSE_BYTES:
+        raise LicenseError("LICENSE_INVALID")
+    try:
+        item = json.loads(data.decode("utf-8"), object_pairs_hook=_unique_pairs)
+        if not isinstance(item, dict) or set(item) != {
+            "schema", "product", "app_version", "fingerprint", "signature"
+        }:
+            raise LicenseError("LICENSE_INVALID")
+        if (type(item["schema"]) is not int or item["schema"] != 1
+                or item["product"] != "MalGuard"
+                or item["app_version"] != PRIVATE_APP_VERSION
+                or not isinstance(item["fingerprint"], str)
+                or re.fullmatch(r"[a-f0-9]{64}", item["fingerprint"]) is None
+                or not isinstance(item["signature"], str)):
+            raise LicenseError("LICENSE_INVALID")
+        signature = base64.b64decode(item.pop("signature"), validate=True)
+        payload = json.dumps(item, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        Ed25519PublicKey.from_public_bytes(bytes.fromhex(public_key_hex)).verify(
+            signature, DOMAIN + payload
+        )
+        if not hmac.compare_digest(item["fingerprint"], fingerprint):
+            raise LicenseError("DEVICE_MISMATCH")
+    except InvalidSignature as error:
+        raise LicenseError("LICENSE_SIGNATURE_INVALID") from error
+    except (UnicodeError, json.JSONDecodeError, binascii.Error, TypeError, ValueError) as error:
+        if isinstance(error, LicenseError):
+            raise
+        raise LicenseError("LICENSE_INVALID") from error
+
+
+def windows_fingerprint() -> str:
