+
+import pytest
+
+from malguard_core.api.scanner import Scanner
+from malguard_core.intake import identify, type_mismatch_evidence
+from malguard_core.intake.description import describe
+from malguard_core.model import ArtifactStatus, Verdict
+from tests.unit.test_foundation import synthetic_pe
+
+
+@pytest.mark.parametrize(('content', 'kind'), [
+    (b'RIFF'+bytes(4)+b'WAVEfmt ', 'WAVE_AUDIO'),
+    (b'ID3'+bytes(20), 'ID3_AUDIO_METADATA'),
+    (b'\xff\xfb\x90\x00'+bytes(12), 'MPEG_AUDIO'),
+    (b'fLaC'+bytes(10), 'FLAC_AUDIO'),
+    (b'OggS'+bytes(10), 'OGG_MEDIA'),
+    (bytes(4)+b'ftypisom'+bytes(10), 'ISO_BASE_MEDIA'),
+    (b'\x89PNG\r\n\x1a\n'+bytes(10), 'PNG_IMAGE'),
+    (b'\xff\xd8\xff'+bytes(10), 'JPEG_IMAGE'),
+    (b'GIF89a'+bytes(10), 'GIF_IMAGE'),
+    (b'RIFF'+bytes(4)+b'WEBP'+bytes(10), 'WEBP_IMAGE'),
+    (b'%PDF-1.7\n', 'PDF_DOCUMENT'),
+])
+def test_content_headers_override_misleading_mod_extension(content, kind):
+    identity = identify(content, '.asi')
+    assert identity['true_type'] == kind
+    assert identity['structure_status'] == ArtifactStatus.MALFORMED
+    info = describe(identity, 'sample.asi', len(content), True)
+    assert info['scope_state'] == 'mismatch'
+    assert info['header_only']
+    assert not info['preview']
+
+
+@pytest.mark.parametrize('extension', ['.txt', '.wav', '.mp3', '.bin'])
+def test_plain_text_is_described_from_bytes_and_never_approved_as_mod(tmp_path, extension):
+    content = 'سلام، این یک متن آزمایشی است.\n'.encode()
+    path = tmp_path / ('sample'+extension)
+    path.write_bytes(content)
+    with Scanner() as scanner:
+        report = scanner.scan_file(path)
+        info = scanner.file_inspection
+    assert report.verdict == Verdict.INCONCLUSIVE
+    assert report.coverage_score < 100
+    assert info['detected_type'] == 'TEXT'
+    assert info['scope_state'] == 'unsupported'
+    assert info['file_size'] == len(content)
+    assert 'سلام' in info['preview']
+    assert report.hashes.sha256 == hashlib.sha256(content).hexdigest()
+
+
+@pytest.mark.parametrize('extension', ['.asi', '.dll', '.zip', '.7z', '.rar'])
+def test_text_claiming_plugin_or_archive_gets_specific_mismatch(tmp_path, extension):
+    path = tmp_path / ('fake'+extension)
+    path.write_text('A harmless plain text description.')
+    with Scanner() as scanner:
+        report = scanner.scan_file(path)
+        assert scanner.file_inspection['scope_state'] == 'mismatch'
+    assert report.verdict == Verdict.INVALID
+
+
+def test_multibyte_character_split_at_prefix_boundary_is_still_text():
+    content = b'a'*8191+'سلام'.encode()
+    identity = identify(content, '.txt')
+    assert identity['true_type'] == 'TEXT'
+    assert identity['preview_bytes'] == 8192
+    assert len(describe(identity, 'notes.txt', len(content), True)['preview']) == 320
+
+
+@pytest.mark.parametrize('encoding', ['utf-16', 'utf-16le', 'utf-16be'])
+def test_unicode_preview_and_secrets_are_bounded_and_redacted(encoding):
+    content = ('password="private-value-12345678"\nhello\u202efile.txt\n'+'x'*9000).encode(encoding)
+    info = describe(identify(content, '.txt'), 'x\u202etest.txt', len(content), True)
+    assert 'private-value' not in info['preview']
+    assert '[REDACTED]' in info['preview']
+    assert '\u202e' not in info['preview']
+    assert '\\u202e' in info['filename']
+    assert info['preview_bytes'] <= 8192
+
+
+def test_description_and_hash_use_same_snapshot_despite_original_change(tmp_path):
+    path = tmp_path / 'sample.txt'
+    original = b'original captured content'
+    path.write_bytes(original)
+    def mutate(stage):
+        if stage == 'reputation':
+            path.write_bytes(b'changed original file')
+    with Scanner(progress=mutate) as scanner:
+        report = scanner.scan_file(path)
+        assert scanner.file_inspection['preview'] == original.decode()
+    assert report.hashes.sha256 == hashlib.sha256(original).hexdigest()
+
+
+def test_observer_failure_cannot_change_verdict_and_no_fake_pe_stage(tmp_path):
+    path = tmp_path / 'mod.lua'
