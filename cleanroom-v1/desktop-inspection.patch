+    notes = {
+        "supported": (
+            "The captured content can enter the static mod-analysis pipeline; identification alone does not establish safety.",
+            "محتوای دریافت‌شده وارد مسیر تحلیل ایستای ماد می‌شود؛ تشخیص نوع به‌تنهایی ایمنی را تأیید نمی‌کند."),
+        "unsupported": (
+            "This content is outside direct GTA mod validation. Raw checks do not validate its format or approve it for installation.",
+            "این محتوا خارج از پوشش تأیید مستقیم ماد GTA است. بررسی بایت‌ها، اعتبار این قالب یا مناسب‌بودن آن برای نصب را ثابت نمی‌کند."),
+        "mismatch": (
+            "The captured bytes do not have the structure required by the claimed mod/archive extension. Renaming a file does not convert its contents.",
+            "بایت‌های فایل ساختار لازم برای پسوند ادعاشدهٔ ماد یا آرشیو را ندارند. تغییر نام یا پسوند، محتوای فایل را تبدیل نمی‌کند."),
+        "empty": ("The file contains zero bytes; there is no mod content to inspect.",
+                  "این فایل صفر بایت دارد؛ محتوای مادی برای بررسی وجود ندارد."),
+        "malformed": (
+            "A supported format header was recognized, but its internal structure could not be parsed as valid. The file may be truncated, damaged or incorrectly packaged.",
+            "سرآیند یک قالب پشتیبانی‌شده شناسایی شد، اما ساختار داخلی معتبر نبود. فایل ممکن است ناقص، آسیب‌دیده یا نادرست بسته‌بندی شده باشد."),
