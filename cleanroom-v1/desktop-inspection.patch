+def test_secret_crossing_preview_edge_is_redacted_before_truncation():
+    token = 'a'*24+'.'+'b'*6+'.'+'c'*27
+    content = ('readme '*41+token+'\n').encode()
+    info = describe(identify(content, '.txt'), 'notes.txt', len(content), True)
+    assert '[REDACTED]' in info['preview']
+    assert 'a'*24 not in info['preview']
+    assert len(info['preview']) <= 320
