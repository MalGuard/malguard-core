+    with Scanner(progress=observer) as scanner:
+        report = scanner.scan_file(path)
+    assert report.verdict == Verdict.SAFE
+    assert seen[0] == 'capture' and seen[-1] == 'finalizing'
+    assert 'script' in seen and 'rules' in seen
+    assert not {'pe', 'dotnet', 'archive'} & set(seen)
+
+
+def test_reuse_resets_inspection_after_missing_file(tmp_path):
+    path = tmp_path / 'test.txt'
+    path.write_text('test')
+    with Scanner() as scanner:
+        scanner.scan_file(path)
+        path.unlink()
+        report = scanner.scan_file(path)
+        assert scanner.file_inspection['scope_state'] == 'unavailable'
+        assert not scanner.file_inspection['size_known']
+        assert not scanner.file_inspection['preview']
+    assert report.verdict == Verdict.INCONCLUSIVE
+
+
+def test_archive_readme_does_not_block_supported_package(tmp_path):
+    stream = io.BytesIO()
+    with zipfile.ZipFile(stream, 'w') as archive:
+        archive.writestr('mod.lua', "print('harmless')")
+        archive.writestr('README.txt', 'Harmless installation notes')
+    path = tmp_path / 'mod.zip'
+    path.write_bytes(stream.getvalue())
+    with Scanner() as scanner:
+        report = scanner.scan_file(path)
+        assert scanner.file_inspection['scope_state'] == 'supported'
+    assert report.verdict == Verdict.SAFE
+
+
+def test_media_disguised_executable_retains_evidence(tmp_path):
+    content = synthetic_pe()
+    identity = identify(content, '.mp3')
+    assert identity['is_pe']
+    assert type_mismatch_evidence(identity, 'sample.mp3', 'x'*64)
+    path = tmp_path / 'sample.mp3'
+    path.write_bytes(content)
+    with Scanner() as scanner:
+        assert scanner.scan_file(path).verdict != Verdict.SAFE
+
+
+def test_empty_file_is_not_identified_as_useful_text(tmp_path):
+    path = tmp_path / 'empty.txt'
+    path.touch()
+    with Scanner() as scanner:
+        assert scanner.scan_file(path).verdict == Verdict.INCONCLUSIVE
+        assert scanner.file_inspection['label_en'] == 'Empty file'
+        assert scanner.file_inspection['scope_state'] == 'empty'
+
