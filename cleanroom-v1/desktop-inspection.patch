+      16,
+      "#64736f",
+      2,
+    );
+  }
+  text(t("evidence"), 18, "#64736f", 1);
+  for (const line of evidenceLines().slice(0, 3)) {
+    text(line, 20, "#203442", 2);
+    if (y > 2210) break;
