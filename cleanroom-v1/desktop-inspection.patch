+:root {
+  color-scheme: dark;
+  --bg: #0b111a;
+  --panel: #111b28;
+  --line: #253348;
+  --ink: #eef3f9;
+  --muted: #9aaabd;
+  --accent: #70e7c0;
+  font-family: Inter, "Segoe UI", Tahoma, Arial, sans-serif;
+  font-synthesis: none;
+}
+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+  background:
+    radial-gradient(ellipse at 15% 0%, #17353360, transparent 48%), var(--bg);
+  color: var(--ink);
+  line-height: 1.65;
+}
+button,
+select {
+  font: inherit;
+}
+button {
+  border: 1px solid transparent;
+  border-radius: 11px;
+  padding: 10px 19px;
+  background: var(--accent);
+  color: #082920;
+  font-weight: 650;
+  cursor: pointer;
+  transition:
+    background 0.2s,
+    transform 0.2s;
+}
+button:hover:not(:disabled) {
+  background: #94f4d6;
+  transform: translateY(-1px);
+}
+button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+button.secondary {
+  background: #1b2c3c;
+  color: var(--ink);
+  border-color: #33495d;
+}
+button.secondary:hover:not(:disabled) {
+  background: #294154;
+}
+button.quiet {
+  background: transparent;
+  color: var(--muted);
+}
+button.quiet:hover:not(:disabled) {
+  background: #203041;
+  color: var(--ink);
+}
+:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 4px;
+}
+[hidden] {
+  display: none !important;
+}
+h1,
+h2,
+h3,
+h4,
+p {
+  margin: 0;
+}
+h2 {
+  font-size: 21px;
+  letter-spacing: -0.4px;
+}
+h3 {
+  line-height: 1.35;
+}
+a {
+  color: inherit;
+  text-decoration: none;
+}
+select {
+  background: #152232;
+  color: var(--ink);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 5px 9px;
+}
+.topbar {
+  max-width: 1100px;
+  margin: auto;
+  padding: 23px 36px;
+  display: flex;
+  gap: 24px;
+  align-items: center;
+  border-bottom: 1px solid var(--line);
+}
+.brand {
+  display: flex;
+  gap: 11px;
+  align-items: center;
+  font-size: 22px;
+  letter-spacing: -0.5px;
+  font-weight: 750;
+}
+.brand small {
+  display: block;
+  font-size: 9px;
+  letter-spacing: 3px;
+  color: var(--muted);
+  line-height: 1.1;
+}
+.brand-mark,
+.footer-mark {
+  display: grid;
+  place-items: center;
+  width: 36px;
+  height: 40px;
+  font-size: 21px;
+  font-weight: 800;
+  background: var(--accent);
+  color: #0c3127;
+  clip-path: polygon(0 0, 100% 0, 100% 76%, 50% 100%, 0 76%);
+}
+.local-pill {
+  margin-inline-start: auto;
+  font-size: 10px;
+  letter-spacing: 1.6px;
+  color: var(--accent);
+}
+.language {
+  font-size: 12px;
+  color: var(--muted);
+  display: flex;
+  gap: 9px;
+  align-items: center;
+}
+main {
+  max-width: 1000px;
+  padding: 40px 36px 24px;
+  margin: auto;
+}
+.intro {
+  margin-bottom: 32px;
+}
+.eyebrow {
+  font-size: 11px;
+  font-weight: 650;
+  letter-spacing: 2.2px;
+  color: var(--accent);
+  margin-bottom: 10px;
+}
+h1 {
+  font-size: clamp(32px, 4.6vw, 49px);
+  letter-spacing: -1.6px;
+  line-height: 1.22;
+  font-weight: 650;
+}
+.intro-copy {
+  max-width: 675px;
+  color: var(--muted);
+  font-size: 15px;
+  margin-top: 15px;
+}
+.build-line {
+  display: flex;
+  gap: 15px;
+  flex-wrap: wrap;
+  font-size: 10px;
+  color: #75879b;
+  margin-top: 20px;
+}
+.build-line bdi {
+  font-family: Consolas, monospace;
+}
+.panel {
+  background: var(--panel);
+  border: 1px solid var(--line);
+  border-radius: 17px;
+  padding: 20px 24px;
+}
+.intelligence {
+  margin-bottom: 38px;
+}
+.intel-heading {
+  display: flex;
+  gap: 10px;
+  align-items: center;
+}
+.intel-heading h2 {
+  font-size: 16px;
+}
+.live-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #738198;
+}
+.intelligence[data-fresh="true"] .live-dot {
+  background: var(--accent);
+  box-shadow: 0 0 12px #70e7c060;
+}
+#updateStatus {
+  font-size: 13px;
+  color: var(--muted);
+  margin: 9px 0 14px;
+}
+.actions {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+.intelligence button {
+  font-size: 12px;
+  padding: 7px 13px;
+}
+.update-details {
+  font-size: 12px;
+  color: var(--muted);
+  margin-top: 14px;
+}
+.update-details summary,
+.raw-report summary {
+  cursor: pointer;
+  color: #b6c5d5;
+}
+.update-details p {
+  margin-top: 10px;
+  max-width: 740px;
+}
+#updateFacts {
+  overflow-wrap: anywhere;
+}
+.section-heading {
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 15px;
+  margin-bottom: 20px;
+}
+.section-heading .eyebrow {
+  color: var(--muted);
+  font-size: 10px;
+}
+.private-label {
+  font-size: 11px;
+  color: var(--muted);
+}
+.scan-shell {
+  position: relative;
+  width: 100%;
+  min-height: 223px;
+  margin-inline: auto;
+  background: linear-gradient(145deg, #142335, #101a27);
+  border: 1px solid #345064;
+  border-radius: 19px;
+  transition:
+    width 0.5s cubic-bezier(0.2, 0.7, 0.3, 1),
+    border-radius 0.5s,
+    background 0.5s;
+  overflow: hidden;
+}
+.file-prompt {
+  text-align: center;
+  padding: 25px 28px;
+}
+.file-symbol {
+  width: 42px;
+  height: 42px;
+  border-radius: 12px;
+  border: 1px solid #3e5f72;
+  display: grid;
+  place-items: center;
+  margin: 0 auto 10px;
+  color: var(--accent);
+  font-size: 25px;
+}
+#filePath {
+  font-size: 16px;
+  font-weight: 600;
+  overflow-wrap: anywhere;
+  max-width: 740px;
+  margin: auto;
+}
+.hint {
+  font-size: 11px;
+  color: var(--muted);
+  margin-top: 8px;
+}
+.scan-actions {
+  justify-content: center;
+  margin-top: 19px;
+}
+.scan-status {
+  min-height: 24px;
+  text-align: center;
+  font-size: 12px;
+  color: var(--muted);
+  margin-top: 12px;
+}
+.scan-shell[data-phase="scanning"] {
+  width: 244px;
+  height: 244px;
+  min-height: 244px;
+  border-radius: 50%;
+  border-color: #284637;
+  background: radial-gradient(circle, #183829, #0e1c24 72%);
+}
+.scan-progress {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  position: absolute;
+  inset: 0;
+  padding: 34px;
+}
+.orbit {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: conic-gradient(
+    from 0deg,
+    transparent 65%,
+    #70e7c035 85%,
+    var(--accent) 99%,
+    transparent
+  );
+  mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 0);
+  animation: orbit 2s linear infinite;
+}
+.progress-kicker {
+  font-size: 11px;
+  color: var(--accent);
+  letter-spacing: 1px;
+}
+#progressStage {
+  font-size: 17px;
+  font-weight: 550;
+  line-height: 1.45;
+  margin: 10px 0;
+  max-width: 195px;
+  min-height: 50px;
+}
+.progress-note {
+  font-size: 10px;
+  color: var(--muted);
+}
+@keyframes orbit {
+  to {
+    transform: rotate(360deg);
+  }
+}
+.scan-shell[data-phase="complete"] {
+  overflow: visible;
+  background: transparent;
+  border-color: transparent;
+  min-height: 0;
+}
+.report-flip {
+  position: relative;
+  transform-style: preserve-3d;
+  transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.3, 1);
+}
+.report-face {
+  backface-visibility: hidden;
+  min-width: 0;
+}
+.report-front {
+  position: relative;
+  padding: 26px;
+  background: linear-gradient(140deg, #192a38, #111c2b);
+  border: 1px solid var(--line);
+  border-radius: 19px;
+}
+.report-back {
+  position: absolute;
+  inset: 0 auto auto 0;
+  width: 100%;
+  transform: rotateY(180deg);
+  visibility: hidden;
+}
+.report-flip.is-flipped {
+  transform: rotateY(180deg);
+}
+.report-flip.is-flipped .report-front {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  visibility: hidden;
+}
+.report-flip.is-flipped .report-back {
+  position: relative;
+  visibility: visible;
+}
+.result-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+}
+.result-copy {
+  max-width: 580px;
+}
+.result-copy h3 {
+  font-size: 26px;
+  font-weight: 650;
+  letter-spacing: -0.5px;
+}
+#verdict[data-verdict="MALICIOUS"] {
+  color: #ff8d94;
+}
+#verdict[data-verdict="SUSPICIOUS"] {
+  color: #f4cf76;
+}
+.filename {
+  overflow-wrap: anywhere;
+  unicode-bidi: plaintext;
+}
+#resultFilename {
+  font-size: 14px;
+  font-weight: 550;
+  margin-top: 12px;
+}
+#resultFacts,
+#resultAdvice {
+  font-size: 12px;
+  color: var(--muted);
+  margin-top: 7px;
+}
+.metrics {
+  font-size: 11px;
+  color: var(--muted);
+  padding-top: 17px;
+  margin-top: 15px;
+  border-top: 1px solid var(--line);
+}
+#detailsButton {
+  font-size: 12px;
+  margin-top: 16px;
+}
+.file-warning {
+  display: flex;
+  gap: 13px;
+  background: #3c1e2850;
+  border: 1px solid #914d60;
+  border-radius: 12px;
+  padding: 15px;
+  margin-bottom: 24px;
+  color: #ffc8ce;
+}
+.warning-mark {
+  width: 23px;
+  height: 23px;
+  flex: none;
+  background: #ffc8ce;
+  color: #421b27;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  font-weight: 800;
+}
+.file-warning h3 {
+  font-size: 15px;
+}
+.file-warning p {
+  font-size: 12px;
+  margin-top: 6px;
+}
+.warning-advice {
+  font-weight: 650;
+}
+.gauge {
+  flex: none;
+  width: 190px;
+  text-align: center;
+  direction: ltr;
+}
+.gauge svg {
+  width: 100%;
+  display: block;
+  overflow: visible;
+}
+.gauge .gauge-name {
+  font-size: 10px;
+  color: var(--muted);
+  margin-top: -6px;
+}
+.gauge .gauge-value {
+  font-size: 21px;
+  font-weight: 650;
+  line-height: 1.2;
+}
+.gauge .gauge-foot {
+  font-size: 9px;
+  color: var(--muted);
+  margin-top: 4px;
+}
+.gauge-needle {
+  transition: transform 0.65s ease;
+  stroke: currentColor;
+  stroke-width: 2.8;
+  stroke-linecap: round;
+}
+.gauge-label {
+  fill: currentColor;
+  font-size: 9px;
+  opacity: 0.7;
+}
+.gauge-hub {
+  fill: currentColor;
+}
+.report-card {
+  color: #203442;
+  background:
+    radial-gradient(circle at 90% 0%, #f5e4b2aa, transparent 40%), #f0f1e9;
+  padding: 34px;
+  border-radius: 19px;
+  border: 1px solid #d7cda8;
+  position: relative;
+  box-shadow: 0 14px 45px #0003;
+}
+.report-card:before {
+  content: "";
+  position: absolute;
+  inset: 10px;
+  pointer-events: none;
+  border: 1px solid #7d876830;
+  border-radius: 11px;
+}
+.card-top {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 20px;
+}
+.card-brand {
+  font-size: 16px;
+  letter-spacing: 3px;
+  font-weight: 750;
+}
+.card-brand span {
+  display: block;
+  font-size: 9px;
+  letter-spacing: 4px;
+  color: #617079;
+}
+.card-seal {
+  width: 49px;
+  height: 49px;
+  border-radius: 50%;
+  outline: 1px solid #ab914e;
+  outline-offset: 4px;
+  border: 1px dashed #aa914e;
+  background: #e9d99f;
+  color: #65501d;
+  display: grid;
+  place-items: center;
+  font-size: 26px;
+  font-weight: 650;
+}
+.card-kicker {
+  font-size: 10px;
+  letter-spacing: 3px;
+  margin-top: 25px;
+  color: #6f796f;
+}
+.report-card h3 {
+  font-size: 30px;
+  font-weight: 600;
+  letter-spacing: -0.5px;
+  margin-top: 9px;
+}
+#cardFilename {
+  font-size: 14px;
+  color: #64717a;
+  margin: 10px 0 15px;
+}
+.report-card .gauge {
+  width: 210px;
+  margin: 5px auto 20px;
+  color: #203442;
+}
+.report-card .gauge-name,
+.report-card .gauge-foot {
+  color: #637074;
+}
+.card-advice {
+  font-size: 13px;
+  text-align: center;
+  max-width: 650px;
+  margin: 0 auto 22px;
+}
+.card-facts {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 17px 24px;
+  margin: 0;
+  padding: 21px 0;
+  border-block: 1px solid #65797430;
+}
+.fact {
+  min-width: 0;
+}
+.fact.wide {
+  grid-column: 1/-1;
+}
+.card-facts dt {
+  font-size: 10px;
+  color: #64736f;
+  margin-bottom: 5px;
+}
+.card-facts dd {
+  margin: 0;
+  font-size: 12px;
+  font-weight: 550;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+.card-facts .hash {
+  font-size: 10px;
+  font-family: Consolas, monospace;
+  direction: ltr;
+  unicode-bidi: plaintext;
+}
+.preview-box {
+  margin-top: 21px;
+  background: #dbe1d880;
+  border: 1px solid #bdc8bc;
+  border-radius: 10px;
+  padding: 14px;
+}
+.preview-box h4,
+.card-evidence h4 {
+  font-size: 12px;
+  font-weight: 650;
+}
+.preview-box pre {
+  font-family: Consolas, Tahoma, monospace;
+  font-size: 11px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  margin: 10px 0;
+  color: #34443d;
+}
+.preview-box p {
+  font-size: 10px;
+  color: #66756c;
+}
+.card-evidence {
+  margin-top: 23px;
+}
+.card-evidence ul {
+  padding-inline-start: 18px;
+  font-size: 11px;
+  margin: 10px 0 0;
+}
+.card-evidence li {
+  margin: 5px 0;
+  overflow-wrap: anywhere;
+}
+.stage-list {
+  list-style: none;
+  padding: 0 !important;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 5px;
+}
+.stage-list li {
+  background: #dbe2d9;
+  border-radius: 5px;
+  padding: 4px 8px;
+  font-size: 9px;
+  margin: 0;
+}
+.stage-list li[data-state="COMPLETE"] {
+  background: #c5dfd0;
+}
+.stage-list li[data-state="FAILED"],
+.stage-list li[data-state="BLOCKED"] {
+  background: #ebcecb;
+}
+.card-disclaimer {
+  font-size: 10px;
+  color: #6a7671;
+  margin-top: 22px;
+  padding-top: 14px;
+  border-top: 1px solid #65797430;
+}
+.card-bottom {
+  display: flex;
+  justify-content: space-between;
+  gap: 15px;
+  font-size: 9px;
+  color: #6a7671;
+  margin-top: 17px;
+  overflow-wrap: anywhere;
+}
+.report-actions {
+  margin-top: 21px;
+  justify-content: center;
+}
+.report-actions button {
+  font-size: 12px;
+}
+.raw-report {
+  font-size: 12px;
+  color: var(--muted);
+  margin-top: 20px;
+}
+.raw-report pre {
+  font-size: 11px;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  background: #101a27;
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 18px;
+  margin-top: 12px;
+}
+footer {
+  border-top: 1px solid var(--line);
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  margin-top: 32px;
+  padding-top: 23px;
+  color: #75899b;
+  font-size: 10px;
+}
+footer p {
+  max-width: 735px;
+}
+.footer-mark {
+  width: 22px;
+  height: 26px;
+  font-size: 13px;
+  flex: none;
+  opacity: 0.6;
+}
+[dir="rtl"] h1,
+[dir="rtl"] h2,
+[dir="rtl"] h3,
+[dir="rtl"] .eyebrow,
+[dir="rtl"] .card-kicker {
+  letter-spacing: 0;
+}
+[dir="rtl"] .report-card {
+  font-family: "Segoe UI", Tahoma, Arial, sans-serif;
+}
+@media (max-width: 720px) {
+  .topbar {
+    padding: 18px 20px;
+    gap: 14px;
+  }
+  .local-pill {
+    display: none;
+  }
+  .language {
+    margin-inline-start: auto;
+  }
+  .language > span {
+    display: none;
+  }
+  main {
+    padding: 30px 20px 22px;
+  }
+  .panel {
+    padding: 18px;
+  }
+  .result-row {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .result-row .gauge {
+    align-self: center;
+    margin-top: 3px;
+  }
+  .report-front {
+    padding: 20px;
+  }
+  .report-card {
+    padding: 27px 23px;
+  }
+  .card-facts {
+    gap: 15px;
+  }
+  .private-label {
+    display: none;
+  }
+  .report-card h3 {
+    font-size: 25px;
+  }
+  .card-bottom {
+    flex-wrap: wrap;
+  }
+  h1 {
+    font-size: 36px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *:before,
+  *:after {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+  .orbit {
+    background: conic-gradient(#70e7c0, transparent 65%);
+  }
+  .report-flip.is-flipped,
+  .report-back {
+    transform: none;
+  }
+}
--- a/desktop/ui/app.js
