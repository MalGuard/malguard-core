 //! Narrow validation for engine telemetry and generated report images.
+
+pub fn update_id(id: &str) -> bool {
+    id.len() == 36
+        && id.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_digit() || (b'a'..=b'f').contains(&b)
+            }
+        })
+}
+
+#[cfg(any(windows, test))]
+pub fn update_progress(bytes: &[u8], id: &str) -> Option<serde_json::Value> {
+    if bytes.len() > 8192 || !update_id(id) {
+        return None;
+    }
+    let value: serde_json::Value = serde_json::from_slice(bytes).ok()?;
+    if value.get("requestId")?.as_str()? != id {
+        return None;
+    }
+    let stage = value.get("stage")?.as_str()?;
+    if ![
+        "preparing",
+        "downloading",
+        "verifying",
+        "comparing",
+        "installing",
+        "complete",
+        "failed",
+    ]
+    .contains(&stage)
+    {
+        return None;
+    }
+    let received = value.get("receivedBytes").and_then(|v| v.as_u64());
+    let total = value.get("totalBytes").and_then(|v| v.as_u64());
+    if stage == "downloading"
+        && (received.is_none()
+            || received? > 23 * 1024 * 1024
+            || total.is_some_and(|n| n == 0 || n > 23 * 1024 * 1024 || received.unwrap() > n))
+    {
+        return None;
+    }
+    Some(
+        serde_json::json!({"requestId": id, "stage": stage, "receivedBytes": received, "totalBytes": total}),
+    )
+}
 
