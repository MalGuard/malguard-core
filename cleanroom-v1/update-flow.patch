+def test_download_progress_counts_actual_bytes(monkeypatch):
+    import io
+    import malguard_core.updates as updates
+    payload = b"harmless transport fixture" * 8000
+    class Response(io.BytesIO):
+        status = 200
+        headers = {"Content-Length": str(len(payload))}
+    class Opener:
+        def open(self, request, timeout):
+            assert request.full_url == updates.UPDATE_URL and timeout == 30
+            return Response(payload)
+    monkeypatch.setattr(updates, "build_opener", lambda *args: Opener())
+    events = []
+    assert updates.download(progress=events.append) == payload
+    counts = [event["receivedBytes"] for event in events]
+    assert counts[0] == 0 and counts[-1] == len(payload)
+    assert counts == sorted(set(counts)) and len(counts) > 3
+    assert all(event["totalBytes"] == len(payload) for event in events)
+
