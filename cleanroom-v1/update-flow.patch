+def test_download_unknown_size_or_incorrect_declared_size(monkeypatch, length, expected):
+    import io
+    import malguard_core.updates as updates
+    class Response(io.BytesIO):
+        status = 200
+        headers = {} if length is None else {"Content-Length": length}
+    class Opener:
+        def open(self, request, timeout):
+            return Response(b"fixture")
+    monkeypatch.setattr(updates, "build_opener", lambda *args: Opener())
+    events = []
+    if expected:
+        assert updates.download(progress=events.append) == b"fixture"
+        assert events[-1]["totalBytes"] is None and events[-1]["receivedBytes"] == 7
+    else:
+        with pytest.raises(UpdateError):
+            updates.download(progress=events.append)
