+def test_desktop_job_reports_authenticated_completion_and_duplicate_counts(publisher, tmp_path, monkeypatch):
+    import malguard_core.updates as updates
+    import malguard_core.updates.desktop as jobs
+    directory = tmp_path / "cache"
+    monkeypatch.setattr(updates, "default_cache_directory", lambda: directory)
+    monkeypatch.setattr(jobs, "default_cache_directory", lambda: directory)
+    monkeypatch.setattr(updates, "ProtectedEpochState", lambda: ProtectedEpochState(tmp_path / "epochs"))
+    first = publisher()
+    monkeypatch.setattr(updates, "download", lambda **kwargs: first)
+    request_id = "12345678-abcd-abcd-abcd-123456789abc"
+    assert jobs.run_job(request_id) == 0
+    result = jobs.read_job(request_id)
+    assert result["stage"] == "complete" and result["result"]["new_record_count"] == 1
+    assert result["result"]["signature_verified"] and result["result"]["fresh"]
+    with pytest.raises(UpdateError):
+        jobs.run_job(request_id)
+    second_id = "12345678-abcd-abcd-abcd-123456789abd"
+    monkeypatch.setattr(updates, "download", lambda **kwargs: publisher(epoch=101, previous=first))
+    assert jobs.run_job(second_id) == 0
+    repeated = jobs.read_job(second_id)
+    assert repeated["result"]["new_record_count"] == 0
+    assert repeated["result"]["update_outcome"] == "up_to_date"
+    altered = json.loads((directory / "latest.json").read_bytes())
+    altered["signature_b64"] = base64.b64encode(bytes(64)).decode()
+    (directory / "latest.json").write_text(json.dumps(altered))
+    with pytest.raises(UpdateError):
+        jobs.read_job(second_id)
+
