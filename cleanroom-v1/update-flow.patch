+def test_install_progress_requires_signature_before_comparison(publisher, tmp_path):
+    events = []
+    directory = tmp_path / "cache"
+    state = ProtectedEpochState(tmp_path / "epochs")
+    valid = publisher()
+    install(valid, directory, state, progress=events.append)
+    assert [e["stage"] for e in events] == ["verifying", "comparing", "installing"]
+    invalid = json.loads(publisher(epoch=101, previous=valid))
+    invalid["signature_b64"] = base64.b64encode(bytes(64)).decode()
+    events.clear()
+    with pytest.raises(BundleError):
+        install(json.dumps(invalid).encode(), directory, state, progress=events.append)
+    assert [e["stage"] for e in events] == ["verifying"]
+    assert (directory / "latest.json").read_bytes() == valid
