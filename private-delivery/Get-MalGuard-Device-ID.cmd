@echo off
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; $k=[Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine,[Microsoft.Win32.RegistryView]::Registry64); try {$s=$k.OpenSubKey('SOFTWARE\Microsoft\Cryptography'); try {$g=[string]$s.GetValue('MachineGuid')} finally {$s.Dispose()}} finally {$k.Dispose()}; $h=[Security.Cryptography.SHA256]::Create(); try {$v=([BitConverter]::ToString($h.ComputeHash([Text.Encoding]::UTF8.GetBytes($g.Trim().ToLowerInvariant())))).Replace('-','').ToLowerInvariant()} finally {$h.Dispose()}; Write-Host 'MalGuard device fingerprint (SHA-256):'; Write-Host $v; Write-Host ''; Write-Host 'Send only the 64-character line to your MalGuard chat.'; Write-Host 'This tool reads the local Windows identifier. It does not install or upload anything.'; Read-Host 'Press Enter to close'"
exit /b %errorlevel%
